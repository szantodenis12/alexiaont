rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Helper to check if a class is active (not locked)
    function isClassActive(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.status == 'active';
    }

    // Classes Rules
    match /classes/{classId} {
      // Admins have full access
      allow write: if isAdmin();
      // Public can read class information (to view list of students and class gallery)
      allow read: if true;

      // Class photos live in a subcollection so a class is not capped by the
      // 1MB document limit (a single album can run to tens of thousands of
      // photos). Subcollections do not inherit the rules above, so the same
      // public-read / admin-write pairing is restated here.
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Submissions Rules
    match /submissions/{submissionId} {
      // Admins have full access
      allow read, write: if isAdmin();
      
      // Students can read their own submission to check status
      allow read: if true;
      
      // Students can create/update their submission if the class is active
      allow create, update: if isClassActive(request.resource.data.classId);
      
      // Prevent deletions by students
      allow delete: if isAdmin();
    }

    // Downloads Rules (Download log tracker)
    match /downloads/{logId} {
      // Admins can read the log entries and manage them
      allow read, write: if isAdmin();
      // Public can create log entries (when they input their email to download)
      allow create: if true;
    }

    // Global Settings and Watermarks Rules
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Premium Photo Galleries Rules
    match /photo_galleries/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();

      // Photos stored in subcollections (bypasses 1MB doc limit)
      match /subcollections/{subId}/photos/{photoId} {
        allow read: if true;        // public, same as parent gallery
        allow write: if isAdmin();  // only authenticated admin
      }
    }

    // Gallery Selections Rules
    match /gallery_selections/{selectionId} {
      allow read, write: if isAdmin();
      allow create: if true;
    }

    // Selection Links Rules
    match /gallery_selection_links/{linkId} {
      allow read, write: if true;
    }

    // Visit statistics (written by src/utils/visitTracker.ts, read in the admin
    // "Statistici" tab). Visitors can only add exactly +1 to a counter or refresh
    // their own presence row; nobody but the admin can read or delete anything.
    match /stats_daily/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;

      match /items/{itemId} {
        allow read: if isAdmin();
        allow create: if itemId.size() < 120
          && request.resource.data.keys().hasOnly(['count', 'kind', 'refId'])
          && request.resource.data.count == 1
          && request.resource.data.kind is string && request.resource.data.kind.size() < 30
          && request.resource.data.refId is string && request.resource.data.refId.size() < 80;
        allow update: if request.resource.data.keys().hasOnly(['count', 'kind', 'refId'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.refId == resource.data.refId;
      }
    }

    match /presence/{sessionId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen', 'kind', 'refId', 'expireAt'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.kind is string && request.resource.data.kind.size() < 30
        && request.resource.data.refId is string && request.resource.data.refId.size() < 80
        && request.resource.data.expireAt is timestamp;
    }

    // Interactive Albums (flipbooks)
    match /flipbooks/{flipbookId} {
      // Public read: an album is shared by an unguessable token in the URL,
      // and the viewer has to query by that token to find it.
      allow read: if true;
      // Only an authenticated admin can create or change an album.
      allow write: if isAdmin();
    }
  }
}
// Force rules update for xiacollection instance
