rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Helper to check if a class accepts uploads. Storage rules can only read the (default)
    // Firestore database, so the app mirrors each class's status/deadline from the named
    // "xiacollection" database into (default)/classStatus/{classId}. Mirror must exist.
    function isClassActive(classId) {
      return firestore.exists(/databases/(default)/documents/classStatus/$(classId))
        && firestore.get(/databases/(default)/documents/classStatus/$(classId)).data.status != 'locked'
        && (!('deadline' in firestore.get(/databases/(default)/documents/classStatus/$(classId)).data)
            || firestore.get(/databases/(default)/documents/classStatus/$(classId)).data.deadline == null
            || request.time < firestore.get(/databases/(default)/documents/classStatus/$(classId)).data.deadline);
    }

    // Class gallery photos uploaded by admin
    match /classes/{classId}/gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global settings and watermarks
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Premium Photo Galleries
    match /galleries/{galleryId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student photo submissions (e.g. processed B/W photos)
    match /submissions/{classId}/{studentName}/{allPaths=**} {
      // Admins have full access
      allow read, write: if isAdmin();
      
      // Public can read submissions
      allow read: if true;
      
      // Students can upload files only if the class status is active
      allow create, update: if isClassActive(classId);
      
      // Prevent deletion by students
      allow delete: if isAdmin();
    }
  }
}
